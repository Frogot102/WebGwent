@inject LocaleService Loc

@if (Card is null)
{
    return;
}

<button type="button"
        data-card-id="@Card.InstanceId"
        class="@CardClasses"
        disabled="@Disabled"
        @onclick="OnClick"
        title="@Tooltip">
    @if (ArtUrl is { } art)
    {
        @* The whole card face: name, row, abilities and the Hero emblem are printed on it.
           Only the live strength is drawn on top (over the printed one); the row shows as the glow. *@
        <span class="card-face" style="background-image: url('@art')">
            @if (CardArt.ShowsStrength(Card))
            {
                <span class="art-strength @CardArt.StrengthTrend(Card)">@Card.CurrentStrength</span>
            }
            @if (CardArt.NamePlate(Card.DefinitionId, Card.Name, Loc.Language) is { } plate)
            {
                @* The picture does not print the card's current name in this language. *@
                <span class="art-name @plate">@Loc.CardName(Card.Name)</span>
            }
        </span>
    }
    else
    {
        <span class="card-banner">
            <span class="strength">@(Card.Type == CardType.Unit ? Card.CurrentStrength.ToString() : "★")</span>
            @if (Card.Type == CardType.Special)
            {
                <span class="row-chip special-chip">@SpecialShort</span>
            }
        </span>
        <span class="card-name">@Loc.CardName(Card.Name)</span>
        <span class="ability-chips">
            @foreach (var a in Card.Abilities.Where(x => x is not Ability.None and not Ability.Hero).Take(3))
            {
                <span class="chip" title="@Loc.Ability(a)">@AbilityShort(a)</span>
            }
            @if (Card.IsHero)
            {
                <span class="chip hero-chip" title="@Loc.Ability(Ability.Hero)">H</span>
            }
        </span>
    }
</button>

@code {
    [Parameter] public CardView? Card { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool JustPlayed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Targetable { get; set; }
    [Parameter] public bool Dimmed { get; set; }
    [Parameter] public EventCallback<CardView> OnSelected { get; set; }

    private string? ArtUrl => Card is null ? null : CardArt.Url(Card.DefinitionId, Card.Name, Loc.Language);

    private string Tooltip => Card is null
        ? ""
        : $"{Loc.CardName(Card.Name)} ({Loc.FactionName(Card.Faction)}) — {Loc.Abilities(Card.Abilities)}";

    private string CardClasses
    {
        get
        {
            if (Card is null) return "gwent-card";
            var parts = new List<string>
            {
                "gwent-card",
                "faction-" + Card.Faction.ToString().ToLowerInvariant()
            };
            if (Selected) parts.Add("selected");
            if (JustPlayed) parts.Add("just-played");
            if (Card.IsHero) parts.Add("hero");
            if (Targetable) parts.Add("decoy-target");
            if (Dimmed) parts.Add("dimmed");
            if (ArtUrl is not null)
            {
                parts.Add("has-art");
                if (CardArt.IsPlainArt(Card.DefinitionId, Card.Name)) parts.Add("art-full");
            }

            if (Card.Type == CardType.Unit) parts.Add("unit");
            else if (Card.Type == CardType.Special) parts.Add("special");
            // The row (or kind of special) is told by the card's colour — its glow on a picture.
            parts.Add(CardArt.GlowClass(Card));

            return string.Join(' ', parts);
        }
    }

    private string SpecialShort
    {
        get
        {
            if (Card is null) return "★";
            if (Card.Abilities.Any(a => a is Ability.WeatherFrost or Ability.WeatherFog
                    or Ability.WeatherRain or Ability.WeatherClear or Ability.WeatherStorm))
                return Loc.Language == AppLanguage.Ru ? "Пг" : "Wx";
            if (Card.Abilities.Contains(Ability.Decoy)) return Loc.Language == AppLanguage.Ru ? "Чч" : "Dc";
            if (Card.Abilities.Contains(Ability.CommandersHorn)) return Loc.Language == AppLanguage.Ru ? "Рг" : "Hn";
            if (Card.Abilities.Any(a => a is Ability.Scorch or Ability.ScorchBattlefield))
                return Loc.Language == AppLanguage.Ru ? "Ис" : "Sc";
            return "★";
        }
    }

    private async Task OnClick()
    {
        if (Card is not null && !Disabled)
            await OnSelected.InvokeAsync(Card);
    }

    private static string AbilityShort(Ability a) => a switch
    {
        Ability.Spy => "Spy",
        Ability.Medic => "Med",
        Ability.TightBond => "TB",
        Ability.MoraleBoost => "MB",
        Ability.Muster => "Mus",
        Ability.Agile => "Agl",
        Ability.Decoy => "Dec",
        Ability.Scorch => "Scr",
        Ability.CommandersHorn => "Horn",
        Ability.WeatherFrost => "Fr",
        Ability.WeatherFog => "Fog",
        Ability.WeatherRain => "Rn",
        Ability.WeatherClear => "Clr",
        Ability.Berserker => "Ber",
        Ability.Mardroeme => "Mar",
        Ability.WeatherStorm => "Stm",
        Ability.ScorchBattlefield => "Scr",
        _ => ""
    };
}
