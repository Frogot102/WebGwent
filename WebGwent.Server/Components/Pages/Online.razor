@page "/online"
@page "/online/room/{Code}"
@layout GameLayout
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject LocaleService Loc
@inject WebGwentApiClient Api
@inject AccountAuthService Auth
@inject TokenStore Tokens
@inject IJSRuntime Js
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.SignalR.Client
@using WebGwent.Game.Models
@using WebGwent.Game.Services
@using WebGwent.Server.Services

<PageTitle>WebGwent — @Loc.T("online.title")</PageTitle>

@* Banner only after we actually try SignalR — avoids false "lost" flash before connect / without Plus *@
@if (_hubStarted)
{
    <div class="conn-banner @ConnBannerClass" role="status">
        <span>@ConnBannerText</span>
        @if (_hub is not null && _hub.State != HubConnectionState.Connected)
        {
            <button type="button" class="btn ghost tiny-btn" disabled="@_busy" @onclick="ManualReconnect">@Loc.T("online.reconnect")</button>
        }
    </div>
}

@if (_view is not null)
{
    <div class="online-meta">
        <span>@Loc.T("online.meta", _code!, _playerIndex + 1)</span>
        <span class="online-meta-sep">·</span>
        <span class="@(_opponentOnline ? "seat-online" : "seat-offline")">
            @(_opponentOnline ? Loc.T("online.opponentOnline") : Loc.T("online.opponentOffline"))
        </span>
        @if (_view.IsYourTurn && _view.Phase == MatchPhase.Playing && TurnSecondsLeft is int left)
        {
            <span class="online-meta-sep">·</span>
            <span class="turn-timer @(left <= 30 ? "turn-timer-warn" : "")">@Loc.T("online.turnTimer", left)</span>
        }
    </div>
    <GameBoard View="_view"
               YouProfile="_youProfile"
               OppProfile="_oppProfile"
               Error="@_error"
               InputLocked="@InputLocked"
               OnMulligan="Mulligan"
               OnFinishMulligan="FinishMulligan"
               OnPlay="PlayCard"
               OnPass="Pass"
               OnUseLeader="UseLeader"
               OnResolvePending="ResolvePending"
               OnChooseStart="ChooseStart" />
}
else if (!string.IsNullOrEmpty(_code) && _seated)
{
    <div class="setup-panel wide room-lobby">
        <p class="eyebrow">@Loc.T("online.lobbyEyebrow")</p>
        <h1>@Loc.T("online.lobbyTitle")</h1>
        <p class="lede">@Loc.T("online.lobbyLede")</p>

        <div class="room-code-block">
            <span class="room-code-label">@Loc.T("online.roomCode")</span>
            <div class="room-code-row">
                <span class="room-code-value">@_code</span>
                <button type="button" class="btn ghost" disabled="@_busy" @onclick="CopyCode">@Loc.T("online.copyCode")</button>
            </div>
            <div class="room-link-row">
                <input class="room-link-input" readonly value="@RoomLink" />
                <button type="button" class="btn ghost" disabled="@_busy" @onclick="CopyLink">@Loc.T("online.copyLink")</button>
            </div>
            @if (!string.IsNullOrEmpty(_copiedHint))
            {
                <p class="muted tiny">@_copiedHint</p>
            }
        </div>

        <div class="room-wait">
            <div class="room-wait-pulse" aria-hidden="true"></div>
            <p class="room-wait-text">@Loc.T("online.waitingOpponent")</p>
            <p class="muted">@Loc.T("online.waitingHint")</p>
            <p class="@(_opponentOnline ? "seat-online" : "seat-offline")">
                @(_opponentOnline ? Loc.T("online.opponentOnline") : Loc.T("online.opponentOffline"))
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error-banner">@_error</p>
        }

        <a class="link-back" href="/online" @onclick="LeaveRoom" @onclick:preventDefault>@Loc.T("online.leaveRoom")</a>
    </div>
}
else if (!_hasPlus)
{
    <div class="setup-panel wide">
        <h1>@Loc.T("online.title")</h1>
        <div class="plus-lock">
            <p class="plus-lock-title">🔒 @Loc.T("plus.lockOnline")</p>
            <p class="muted">@Loc.T("plus.lockOnlineDesc")</p>
            <a class="btn primary" href="/account/profile">@Loc.T("plus.goProfile")</a>
            <a class="link-back" href="/home">@Loc.T("online.back")</a>
        </div>
    </div>
}
else
{
    <div class="setup-panel wide">
        <h1>@Loc.T("online.title")</h1>
        <label>@Loc.T("online.name") <input @bind="_name" maxlength="24" /></label>
        <label>@Loc.T("play.yourDeck")
            <select @bind="_deckId">
                @foreach (var d in _decks)
                {
                    <option value="@d.Id">@((d.IsPreset ? "★ " : "") + d.Name + " (" + Loc.FactionName(d.Faction) + ")")</option>
                }
            </select>
        </label>

        <div class="online-actions">
            <button class="btn primary" disabled="@(_busy || _hub is null || _hub.State != HubConnectionState.Connected)" @onclick="CreateRoom">@Loc.T("online.create")</button>
            <div class="join-row">
                <input @bind="_joinCode" placeholder="@Loc.T("online.codePlaceholder")" maxlength="5" />
                <button class="btn" disabled="@(_busy || _hub is null || _hub.State != HubConnectionState.Connected)" @onclick="JoinRoom">@Loc.T("online.join")</button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error-banner">@_error</p>
        }
        <a class="link-back" href="/home">@Loc.T("online.back")</a>
    </div>
}

@code {
    private const string SeatKey = "webgwent.online.seat";

    [Parameter] public string? Code { get; set; }

    private HubConnection? _hub;
    private string _name = "Geralt";
    private Guid _deckId;
    private string _joinCode = "";
    private string? _code;
    private int _playerIndex = -1;
    private bool _seated;
    private MatchView? _view;
    private BoardProfile? _youProfile;
    private BoardProfile? _oppProfile;
    private string? _error;
    private string? _copiedHint;
    private bool _busy;
    private bool _hasPlus;
    private bool _hubStarted;
    private long _boardRevision;
    private bool _opponentOnline;
    private HubConnectionState _connState = HubConnectionState.Connecting;
    private CancellationTokenSource? _timerCts;
    private int? _turnSecondsLeft;
    private List<DeckDto> _decks = [];

    private bool InputLocked =>
        _hub is null || _hub.State != HubConnectionState.Connected;

    private int? TurnSecondsLeft => _turnSecondsLeft;

    private string RoomLink =>
        string.IsNullOrEmpty(_code) ? "" : Nav.ToAbsoluteUri($"/online/room/{_code}").ToString();

    private string ConnBannerClass => _connState switch
    {
        HubConnectionState.Connected => "conn-ok",
        HubConnectionState.Connecting or HubConnectionState.Reconnecting => "conn-warn",
        _ => "conn-bad"
    };

    private string ConnBannerText => _connState switch
    {
        HubConnectionState.Connected => Loc.T("online.connOk"),
        HubConnectionState.Connecting => Loc.T("online.connConnecting"),
        HubConnectionState.Reconnecting => Loc.T("online.connReconnecting"),
        _ => Loc.T("online.connLost")
    };

    private void OnLang() => InvokeAsync(StateHasChanged);

    private void ResetMatchLocalState()
    {
        _boardRevision = 0;
        _view = null;
        _youProfile = null;
        _oppProfile = null;
        _error = null;
        _turnSecondsLeft = null;
        StopTurnTimer();
    }

    private void SyncConnState()
    {
        _connState = _hub?.State ?? HubConnectionState.Disconnected;
    }

    protected override async Task OnInitializedAsync()
    {
        Loc.Changed += OnLang;
        var account = await Auth.GetCurrentAsync();
        _hasPlus = account?.HasPlus == true;
        if (account is not null)
            _name = account.DisplayName;

        _decks = (await Api.GetDecksAsync()).ToList();
        if (_decks.Count > 0)
        {
            var fav = account?.FavoriteFaction ?? Faction.NorthernRealms;
            _deckId = _decks.FirstOrDefault(d => d.Faction == fav)?.Id
                      ?? _decks.FirstOrDefault(d => d.Faction == Faction.NorthernRealms)?.Id
                      ?? _decks[0].Id;
        }

        if (!_hasPlus)
            return;

        _hubStarted = true;
        _connState = HubConnectionState.Connecting;
        var hubUrl = Api.BaseAddress + "/hubs/game";
        _hub = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                options.AccessTokenProvider = async () => await Tokens.GetAsync();
            })
            .WithAutomaticReconnect([
                TimeSpan.Zero,
                TimeSpan.FromSeconds(1),
                TimeSpan.FromSeconds(2),
                TimeSpan.FromSeconds(5),
                TimeSpan.FromSeconds(10)
            ])
            .WithServerTimeout(TimeSpan.FromSeconds(120))
            .WithKeepAliveInterval(TimeSpan.FromSeconds(15))
            .AddJsonProtocol(o =>
            {
                o.PayloadSerializerOptions.PropertyNameCaseInsensitive = true;
                o.PayloadSerializerOptions.Converters.Add(new JsonStringEnumConverter());
            })
            .Build();

        _hub.On<MatchBoardDto>("MatchUpdated", update =>
        {
            _ = InvokeAsync(() =>
            {
                try
                {
                    ApplyBoard(update);
                    StateHasChanged();
                }
                catch (ObjectDisposedException) { }
                catch (JSDisconnectedException) { }
                return Task.CompletedTask;
            });
        });
        _hub.On<string>("OpponentJoined", code =>
        {
            _ = InvokeAsync(() => OnOpponentJoinedAsync(code));
        });
        _hub.On<SeatStatusDto>("SeatStatus", status =>
        {
            _ = InvokeAsync(() =>
            {
                if (_playerIndex < 0 || string.IsNullOrEmpty(_code)) return Task.CompletedTask;
                if (!string.Equals(status.Code, _code, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
                if (status.PlayerIndex == _playerIndex) return Task.CompletedTask;
                _opponentOnline = status.Online;
                StateHasChanged();
                return Task.CompletedTask;
            });
        });
        _hub.On<string>("Error", msg =>
        {
            _ = InvokeAsync(() =>
            {
                _error = MapHubError(msg);
                StateHasChanged();
                return Task.CompletedTask;
            });
        });

        _hub.Reconnecting += _ => InvokeAsync(() =>
        {
            SyncConnState();
            StateHasChanged();
            return Task.CompletedTask;
        });
        _hub.Reconnected += async _ =>
        {
            SyncConnState();
            if (_seated && !string.IsNullOrEmpty(_code) && _playerIndex >= 0)
            {
                try { await _hub.SendAsync("Reconnect", _code, _playerIndex); }
                catch { /* refresh below */ }
                await RefreshBoardAsync();
                await RefreshSeatPresenceAsync();
            }
            await InvokeAsync(StateHasChanged);
        };
        _hub.Closed += _ => InvokeAsync(() =>
        {
            SyncConnState();
            StateHasChanged();
            return Task.CompletedTask;
        });

        SyncConnState();
        await _hub.StartAsync();
        SyncConnState();

        if (!string.IsNullOrWhiteSpace(Code))
        {
            var routeCode = Code.Trim().ToUpperInvariant();
            _joinCode = routeCode;
            if (await TryRestoreSeatAsync(routeCode))
            {
                try { await _hub.SendAsync("Reconnect", _code, _playerIndex); }
                catch { /* GetBoard may still work after group join via GetBoard */ }
                await RefreshBoardAsync();
                await RefreshSeatPresenceAsync();
            }
        }
    }

    private void ApplyBoard(MatchBoardDto? update)
    {
        if (update is null) return;
        if (update.Revision > 0 && update.Revision < _boardRevision)
            return;
        if (update.Revision > 0)
            _boardRevision = update.Revision;
        _view = update.View;
        _youProfile = update.You;
        _oppProfile = update.Opponent;
        _error = null;
        EnsureTurnTimer();
    }

    private void EnsureTurnTimer()
    {
        if (_view is null || _view.Phase != MatchPhase.Playing || !_view.IsYourTurn)
        {
            _turnSecondsLeft = null;
            StopTurnTimer();
            return;
        }
        if (_timerCts is not null) return;
        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
                while (await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(() =>
                    {
                        UpdateTurnSeconds();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException) { }
        }, token);
        UpdateTurnSeconds();
    }

    private void UpdateTurnSeconds()
    {
        if (_view is null || _view.Phase != MatchPhase.Playing || !_view.IsYourTurn)
        {
            _turnSecondsLeft = null;
            return;
        }
        var limit = _view.TurnTimeoutSeconds > 0 ? _view.TurnTimeoutSeconds : 180;
        var left = limit - (int)(DateTime.UtcNow - _view.LastActionUtc).TotalSeconds;
        _turnSecondsLeft = Math.Max(0, left);
    }

    private void StopTurnTimer()
    {
        try { _timerCts?.Cancel(); } catch { /* ignore */ }
        _timerCts?.Dispose();
        _timerCts = null;
    }

    private async Task OnOpponentJoinedAsync(string code)
    {
        if (!_seated || string.IsNullOrEmpty(_code))
            return;
        if (!string.Equals(code, _code, StringComparison.OrdinalIgnoreCase))
            return;
        _opponentOnline = true;
        await RefreshBoardAsync();
        StateHasChanged();
    }

    private async Task RefreshBoardAsync()
    {
        if (_hub is null || !_seated || string.IsNullOrEmpty(_code) || _playerIndex < 0)
            return;
        try
        {
            var board = await _hub.InvokeAsync<MatchBoardDto?>("GetBoard", _code, _playerIndex);
            if (board is not null)
                ApplyBoard(board);
        }
        catch (Exception ex)
        {
            _error = MapHubError(ex.Message);
        }
    }

    private async Task RefreshSeatPresenceAsync()
    {
        if (_hub is null || string.IsNullOrEmpty(_code) || _playerIndex < 0)
            return;
        try
        {
            var p = await _hub.InvokeAsync<SeatPresenceDto>("GetSeatPresence", _code);
            _opponentOnline = _playerIndex == 0 ? p.GuestOnline : p.HostOnline;
        }
        catch { /* ignore */ }
    }

    private async Task ManualReconnect()
    {
        if (_hub is null) return;
        _busy = true;
        _error = null;
        try
        {
            if (_hub.State == HubConnectionState.Disconnected)
                await _hub.StartAsync();
            SyncConnState();
            if (_seated && !string.IsNullOrEmpty(_code) && _playerIndex >= 0)
            {
                await _hub.SendAsync("Reconnect", _code, _playerIndex);
                await RefreshBoardAsync();
                await RefreshSeatPresenceAsync();
            }
        }
        catch (Exception ex)
        {
            _error = MapHubError(ex.Message);
            SyncConnState();
        }
        finally { _busy = false; }
    }

    private async Task SaveSeatAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("sessionStorage.setItem", SeatKey, $"{_code}|{_playerIndex}");
        }
        catch { /* ignore */ }
    }

    private async Task ClearSeatAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("sessionStorage.removeItem", SeatKey);
        }
        catch { /* ignore */ }
    }

    private async Task<bool> TryRestoreSeatAsync(string routeCode)
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("sessionStorage.getItem", SeatKey);
            if (string.IsNullOrEmpty(raw)) return false;
            var parts = raw.Split('|');
            if (parts.Length != 2) return false;
            if (!string.Equals(parts[0], routeCode, StringComparison.OrdinalIgnoreCase)) return false;
            if (!int.TryParse(parts[1], out var idx) || idx is not (0 or 1)) return false;
            _code = routeCode;
            _playerIndex = idx;
            _seated = true;
            return true;
        }
        catch
        {
            return false;
        }
    }

    private string MapHubError(string msg) =>
        msg.Contains("PlusRequired", StringComparison.OrdinalIgnoreCase)
            ? Loc.T("plus.required")
            : msg;

    private async Task CreateRoom()
    {
        if (_hub is null || !_hasPlus) return;
        _busy = true;
        _error = null;
        try
        {
            var deck = _decks.FirstOrDefault(d => d.Id == _deckId);
            var result = await _hub.InvokeAsync<RoomCreatedDto>(
                "CreateRoom",
                deck?.Faction.ToString() ?? "NorthernRealms",
                _name,
                _deckId.ToString());
            ResetMatchLocalState();
            _code = result.Code;
            _playerIndex = result.PlayerIndex;
            _seated = true;
            _opponentOnline = false;
            await SaveSeatAsync();
            Nav.NavigateTo($"/online/room/{_code}", replace: true);
        }
        catch (Exception ex)
        {
            _error = MapHubError(ex.Message);
        }
        finally { _busy = false; }
    }

    private async Task JoinRoom()
    {
        if (_hub is null || !_hasPlus) return;
        _busy = true;
        _error = null;
        try
        {
            var deck = _decks.FirstOrDefault(d => d.Id == _deckId);
            var result = await _hub.InvokeAsync<JoinedRoomDto>(
                "JoinRoom",
                _joinCode,
                deck?.Faction.ToString() ?? "NorthernRealms",
                _name,
                _deckId.ToString());
            ResetMatchLocalState();
            _code = result.Code;
            _playerIndex = result.PlayerIndex;
            _seated = true;
            _opponentOnline = true;
            await SaveSeatAsync();
            await RefreshBoardAsync();
            Nav.NavigateTo($"/online/room/{_code}", replace: true);
        }
        catch (Exception ex)
        {
            _error = MapHubError(ex.Message);
        }
        finally { _busy = false; }
    }

    private async Task LeaveRoom()
    {
        try
        {
            if (_hub is not null && !string.IsNullOrEmpty(_code))
                await _hub.SendAsync("LeaveRoom", _code);
        }
        catch { /* ignore */ }
        await ClearSeatAsync();
        ResetMatchLocalState();
        _code = null;
        _seated = false;
        _playerIndex = -1;
        _opponentOnline = false;
        Nav.NavigateTo("/online");
    }

    private async Task CopyCode()
    {
        if (string.IsNullOrEmpty(_code)) return;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _code);
            _copiedHint = Loc.T("online.copied");
        }
        catch
        {
            _copiedHint = _code;
        }
    }

    private async Task CopyLink()
    {
        if (string.IsNullOrEmpty(RoomLink)) return;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", RoomLink);
            _copiedHint = Loc.T("online.linkCopied");
        }
        catch
        {
            _copiedHint = RoomLink;
        }
    }

    private Task Mulligan(Guid id) => GuardSend(() => _hub!.SendAsync("Mulligan", _code, _playerIndex, id));
    private Task FinishMulligan() => GuardSend(() => _hub!.SendAsync("FinishMulligan", _code, _playerIndex));
    private Task Pass() => GuardSend(() => _hub!.SendAsync("Pass", _code, _playerIndex));
    private Task UseLeader() => GuardSend(() => _hub!.SendAsync("UseLeader", _code, _playerIndex));
    private Task PlayCard((Guid CardId, CombatRow? Row, Guid? Target) a) =>
        GuardSend(() => _hub!.SendAsync("PlayCard", _code, _playerIndex, a.CardId, a.Row?.ToString(), a.Target));
    private Task ResolvePending((Guid? Target, CombatRow? Row) a) =>
        GuardSend(() => _hub!.SendAsync("ResolvePending", _code, _playerIndex, a.Target, a.Row?.ToString()));
    private Task ChooseStart(int who) =>
        GuardSend(() => _hub!.SendAsync("ChooseWhoStarts", _code, _playerIndex, who));

    private async Task GuardSend(Func<Task> send)
    {
        if (InputLocked) return;
        try { await send(); }
        catch (Exception ex) { _error = MapHubError(ex.Message); }
    }

    public async ValueTask DisposeAsync()
    {
        Loc.Changed -= OnLang;
        StopTurnTimer();
        if (_hub is not null)
            await _hub.DisposeAsync();
    }

    private sealed record RoomCreatedDto(string Code, int PlayerIndex);
    private sealed record JoinedRoomDto(string Code, int PlayerIndex, Guid MatchId);
    private sealed record SeatStatusDto(string Code, int PlayerIndex, bool Online);
    private sealed record SeatPresenceDto(string Code, bool HostOnline, bool GuestOnline);
}
