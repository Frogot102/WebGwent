@page "/account/login"
@page "/"
@attribute [AllowAnonymous]
@layout AuthLayout
@inject AccountAuthService Auth
@inject NavigationManager Nav
@inject LocaleService Loc
@using WebGwent.Server.Accounts
@using WebGwent.Server.Services

<PageTitle>WebGwent — @Loc.T("auth.login")</PageTitle>

<section class="auth-gate">
    <div class="auth-brand">
        <p class="eyebrow">@Loc.T("home.eyebrow")</p>
        <h1>WebGwent</h1>
        <p class="lede">@Loc.T("auth.gateLede")</p>
    </div>

    <div class="setup-panel wide account-panel">
        <h2>@Loc.T("auth.login")</h2>
        <label>@Loc.T("auth.username")
            <input @bind="_username" maxlength="24" autocomplete="username" />
        </label>
        <label>@Loc.T("auth.password")
            <input @bind="_password" type="password" maxlength="64" autocomplete="current-password" />
        </label>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-banner">@_error</div>
        }
        <button type="button" class="btn primary" disabled="@_busy" @onclick="DoLogin">@Loc.T("auth.login")</button>
        <p class="account-switch">@Loc.T("auth.noAccount") <a href="/account/register">@Loc.T("auth.register")</a></p>
        <p class="muted tiny auth-demo-hint">@Loc.T("auth.demoAdmin", BuiltInAdmin.Username, BuiltInAdmin.Password)</p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.GetCurrentAsync() is not null)
            Nav.NavigateTo(SafeReturn(ReturnUrl) ?? "/home", replace: true);
    }

    private async Task DoLogin()
    {
        _busy = true;
        _error = null;
        try
        {
            await Auth.SignInWithPasswordAsync(_username, _password);
            Nav.NavigateTo(SafeReturn(ReturnUrl) ?? "/home");
        }
        catch
        {
            _error = Loc.T("auth.err.badCredentials");
        }
        finally { _busy = false; }
    }

    private static string? SafeReturn(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var path = raw.Trim();
        if (!path.StartsWith('/') || path.StartsWith("//", StringComparison.Ordinal)) return null;
        return path;
    }
}
