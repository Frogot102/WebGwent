@page "/account/login"
@page "/"
@attribute [AllowAnonymous]
@layout AuthLayout
@rendermode InteractiveServer
@inject AccountAuthService Auth
@inject NavigationManager Nav
@inject LocaleService Loc

<PageTitle>WebGwent — @Loc.T("auth.login")</PageTitle>

<section class="auth-gate">
    <div class="auth-brand">
        <p class="eyebrow">@Loc.T("home.eyebrow")</p>
        <h1>WebGwent</h1>
        <p class="lede">@Loc.T("auth.gateLede")</p>
    </div>

    @* Classic form POST — works even if the Blazor circuit is not connected. *@
    <form class="setup-panel wide account-panel" method="post" action="/api/auth/login">
        <h2>@Loc.T("auth.login")</h2>
        <label>@Loc.T("auth.username")
            <input name="username" value="@_username" maxlength="24" autocomplete="username" required />
        </label>
        <label>@Loc.T("auth.password")
            <input name="password" type="password" maxlength="64" autocomplete="current-password" required />
        </label>
        @if (!string.IsNullOrEmpty(ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-banner">@_error</div>
        }
        <button type="submit" class="btn primary">@Loc.T("auth.login")</button>
        <p class="account-switch">@Loc.T("auth.noAccount") <a href="/account/register">@Loc.T("auth.register")</a></p>
    </form>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }

    private string _username = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.GetCurrentAsync() is not null)
        {
            Nav.NavigateTo("/home", replace: true);
            return;
        }

        _error = ErrorCode switch
        {
            "bad" => Loc.T("auth.err.badCredentials"),
            _ => null
        };
    }
}
