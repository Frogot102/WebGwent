@page "/account/register"
@attribute [AllowAnonymous]
@layout AuthLayout
@inject LocaleService Loc
@inject AccountAuthService Auth
@inject NavigationManager Nav
@using WebGwent.Server.Services

<PageTitle>WebGwent — @Loc.T("auth.register")</PageTitle>

<section class="auth-gate">
    <div class="auth-brand">
        <p class="eyebrow">@Loc.T("home.eyebrow")</p>
        <h1>WebGwent</h1>
        <p class="lede">@Loc.T("auth.gateLede")</p>
    </div>

    <div class="setup-panel wide account-panel">
        <h2>@Loc.T("auth.register")</h2>
        <label>@Loc.T("auth.username")
            <input @bind="_username" maxlength="24" autocomplete="username" />
        </label>
        <label>@Loc.T("auth.displayName")
            <input @bind="_displayName" maxlength="24" />
        </label>
        <label>@Loc.T("auth.password")
            <input @bind="_password" type="password" maxlength="64" autocomplete="new-password" />
        </label>
        <label>@Loc.T("auth.passwordConfirm")
            <input @bind="_passwordConfirm" type="password" maxlength="64" autocomplete="new-password" />
        </label>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-banner">@_error</div>
        }
        <button type="button" class="btn primary" disabled="@_busy" @onclick="DoRegister">@Loc.T("auth.register")</button>
        <p class="account-switch">@Loc.T("auth.hasAccount") <a href="/account/login">@Loc.T("auth.login")</a></p>
    </div>
</section>

@code {
    private string _username = "";
    private string _displayName = "";
    private string _password = "";
    private string _passwordConfirm = "";
    private string? _error;
    private bool _busy;

    private async Task DoRegister()
    {
        _busy = true;
        _error = null;
        try
        {
            await Auth.RegisterAsync(_username, _password, _passwordConfirm, _displayName);
            Nav.NavigateTo("/home");
        }
        catch (InvalidOperationException ex)
        {
            _error = Loc.T(ex.Message switch
            {
                "mismatch" => "auth.err.passwordMismatch",
                "UsernameTaken" => "auth.err.usernameTaken",
                "UsernameLength" => "auth.err.usernameLength",
                "UsernameChars" => "auth.err.usernameChars",
                "PasswordLength" => "auth.err.passwordLength",
                _ => "auth.err.save"
            });
        }
        finally { _busy = false; }
    }
}
