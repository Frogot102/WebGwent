@page "/account/profile"
@rendermode InteractiveServer
@inject AccountAuthService Auth
@inject AccountStore Store
@inject InviteStore Invites
@inject LocaleService Loc

<PageTitle>WebGwent — @Loc.T("auth.profile")</PageTitle>

@if (_account is null)
{
    <div class="setup-panel wide">
        <h1>@Loc.T("auth.profile")</h1>
        <p class="muted">@Loc.T("auth.needLogin")</p>
        <a class="btn primary" href="/account/login">@Loc.T("auth.login")</a>
    </div>
}
else
{
    <div class="profile-page">
        <section class="profile-card">
            <PlayerAvatar Account="_account" CssClass="profile-avatar" Size="72" />
            <div class="profile-head">
                <h1>@_account.DisplayName</h1>
                <p class="muted">
                    @($"@{_account.Username}") · @Loc.T("auth.rating") <strong>@_account.Rating</strong>
                    @if (_account.Role == AccountRole.Admin)
                    {
                        <span class="plus-pill">Admin</span>
                    }
                    else if (_account.HasPlus)
                    {
                        <span class="plus-pill">Plus</span>
                    }
                </p>
            </div>
            <dl class="profile-stats">
                <div>
                    <dt>@Loc.T("auth.favFaction")</dt>
                    <dd>
                        @Loc.FactionName(_account.FavoriteFaction)
                        @if (_favCount > 0)
                        {
                            <span class="muted"> · @Loc.T("auth.favFactionMatches", _favCount)</span>
                        }
                        else
                        {
                            <span class="muted"> · @Loc.T("auth.favFactionNone")</span>
                        }
                    </dd>
                </div>
                <div><dt>@Loc.T("auth.vsPlayers")</dt><dd>@_account.MatchesVsPlayers (@_account.WinsVsPlayers/@_account.LossesVsPlayers/@_account.DrawsVsPlayers)</dd></div>
                <div><dt>@Loc.T("auth.vsBot")</dt><dd>@_account.MatchesVsBot (@_account.WinsVsBot/@_account.LossesVsBot)</dd></div>
            </dl>
        </section>

        <section class="setup-panel wide account-panel plus-panel">
            <h2>WebGwent Plus</h2>
            <p class="muted">@Loc.T("plus.benefits")</p>
            @if (_account.HasPlus)
            {
                <p class="ok-banner">
                    @if (_account.Role == AccountRole.Admin)
                    {
                        @Loc.T("plus.activeAdmin")
                    }
                    else
                    {
                        @Loc.T("plus.activeUntil", _account.PlusUntilUtc?.ToLocalTime().ToString("g") ?? "—")
                    }
                </p>
            }
            else
            {
                <p class="muted">@Loc.T("plus.inactive")</p>
            }

            <div class="plus-buy-row">
                <label>@Loc.T("plus.buyLabel")
                    <select @bind="_buyMonths">
                        <option value="1">1 @Loc.T("plus.month")</option>
                        <option value="3">3 @Loc.T("plus.months")</option>
                        <option value="12">12 @Loc.T("plus.months")</option>
                    </select>
                </label>
                <button class="btn primary" disabled="@_busy" @onclick="BuyPlus">@Loc.T("plus.buyDemo")</button>
            </div>
            <p class="muted tiny">@Loc.T("plus.demoNote")</p>

            <label>@Loc.T("plus.inviteCode")
                <input @bind="_inviteCode" maxlength="32" placeholder="WGNT-XXXX-XXXX" />
            </label>
            <button class="btn ghost" disabled="@_busy" @onclick="RedeemInvite">@Loc.T("plus.activate")</button>

            @if (!string.IsNullOrEmpty(_plusMessage))
            {
                <p class="@(_plusOk ? "ok-banner" : "error-banner")">@_plusMessage</p>
            }
        </section>

        @if (_account.Role == AccountRole.Admin)
        {
            <section class="setup-panel wide account-panel">
                <h2>@Loc.T("plus.adminInvites")</h2>
                <div class="invite-create">
                    <label>@Loc.T("plus.durationDays")
                        <input type="number" @bind="_inviteDays" min="1" max="3650" />
                    </label>
                    <label>@Loc.T("plus.maxActivations")
                        <input type="number" @bind="_inviteMax" min="1" max="1000" />
                    </label>
                    <button class="btn primary" disabled="@_busy" @onclick="CreateInvite">@Loc.T("plus.createInvite")</button>
                </div>
                @if (!string.IsNullOrEmpty(_createdCode))
                {
                    <p class="ok-banner">@Loc.T("plus.createdCode"): <code>@_createdCode</code>
                        <button class="btn ghost" type="button" @onclick="() => _createdCode = null">OK</button>
                    </p>
                }
                <ul class="invite-list">
                    @foreach (var inv in _invites)
                    {
                        <li class="invite-row @(inv.Revoked || inv.UsedCount >= inv.MaxActivations ? "is-used" : "")">
                            <code>@inv.Code</code>
                            <span>@inv.DurationDays d · @inv.UsedCount/@inv.MaxActivations</span>
                            <button class="btn ghost" type="button" disabled="@_busy" @onclick="() => DeleteInvite(inv.Id)">@Loc.T("plus.deleteInvite")</button>
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="setup-panel wide account-panel">
            <h2>@Loc.T("auth.editProfile")</h2>
            <label>@Loc.T("auth.displayName")
                <input @bind="_displayName" maxlength="24" />
            </label>

            <div class="avatar-edit">
                <span class="avatar-edit-label">@Loc.T("auth.avatar")</span>
                <div class="avatar-edit-row">
                    <PlayerAvatar Account="_previewAccount" CssClass="profile-avatar avatar-preview" Size="72" />
                    <div class="avatar-edit-controls">
                        <label class="btn ghost file-btn">
                            @Loc.T("auth.avatarUpload")
                            <InputFile OnChange="OnAvatarSelected" accept="image/png,image/jpeg,image/webp,image/gif" />
                        </label>
                        <p class="muted tiny">@Loc.T("auth.avatarHint")</p>
                    </div>
                </div>
                <div class="avatar-picker">
                    @foreach (var a in AvatarCatalog.All)
                    {
                        <button type="button"
                                class="avatar-option @(_avatarId == a.Id ? "selected" : "")"
                                @onclick="() => SelectPreset(a.Id)"
                                title="@(Loc.Language == AppLanguage.Ru ? a.LabelRu : a.LabelEn)">
                            @a.Glyph
                        </button>
                    }
                    @if (_hasCustomFile)
                    {
                        <button type="button"
                                class="avatar-option avatar-option-custom @(_avatarId == AvatarCatalog.CustomId ? "selected" : "")"
                                @onclick="() => SelectPreset(AvatarCatalog.CustomId)"
                                title="@Loc.T("auth.avatarCustom")">
                            <img src="@AvatarCatalog.ImageUrl(_account.Id, _account.AvatarVersion)" alt="" />
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <p class="@(_ok ? "ok-banner" : "error-banner")">@_message</p>
            }
            <button class="btn primary" disabled="@_busy" @onclick="Save">@Loc.T("auth.save")</button>
            <a class="btn ghost" href="/account/history">@Loc.T("auth.history")</a>
            <a class="btn ghost" href="/api/auth/logout">@Loc.T("auth.logout")</a>
        </section>
    </div>
}

@code {
    private PlayerAccount? _account;
    private string _displayName = "";
    private string _avatarId = "wolf";
    private int _favCount;
    private string? _message;
    private bool _ok;
    private bool _busy;
    private bool _hasCustomFile;

    private int _buyMonths = 1;
    private string _inviteCode = "";
    private string? _plusMessage;
    private bool _plusOk;
    private int _inviteDays = 30;
    private int _inviteMax = 1;
    private string? _createdCode;
    private List<InviteRecord> _invites = [];

    private PlayerAccount? _previewAccount => _account is null
        ? null
        : new PlayerAccount
        {
            Id = _account.Id,
            AvatarId = _avatarId,
            AvatarVersion = _account.AvatarVersion,
            DisplayName = _displayName,
            Username = _account.Username
        };

    protected override async Task OnInitializedAsync()
    {
        _account = await Auth.GetCurrentAsync();
        if (_account is null) return;
        _displayName = _account.DisplayName;
        _avatarId = _account.AvatarId;
        _favCount = Store.FavoriteFactionMatchCount(_account.Id);
        _hasCustomFile = Store.FindAvatarFile(_account.Id) is not null;
        if (_account.Role == AccountRole.Admin)
            _invites = Invites.List().ToList();
    }

    private void SelectPreset(string id)
    {
        _avatarId = id;
        _message = null;
    }

    private void BuyPlus()
    {
        if (_account is null) return;
        _busy = true;
        try
        {
            _account = Store.PurchasePlusMonths(_account.Id, _buyMonths);
            _plusOk = true;
            _plusMessage = Loc.T("plus.bought");
        }
        catch
        {
            _plusOk = false;
            _plusMessage = Loc.T("plus.err.buy");
        }
        finally { _busy = false; }
    }

    private void RedeemInvite()
    {
        if (_account is null) return;
        _busy = true;
        try
        {
            var days = Invites.Redeem(_inviteCode, _account.Id, _account.Username);
            _account = Store.GrantPlusDays(_account.Id, days);
            _inviteCode = "";
            _plusOk = true;
            _plusMessage = Loc.T("plus.redeemed", days);
            if (_account.Role == AccountRole.Admin)
                _invites = Invites.List().ToList();
        }
        catch (InvalidOperationException ex)
        {
            _plusOk = false;
            _plusMessage = Loc.T(ex.Message switch
            {
                "InviteInvalid" => "plus.err.invalid",
                "InviteExhausted" => "plus.err.exhausted",
                "InviteExpired" => "plus.err.expired",
                "InviteAlreadyUsed" => "plus.err.alreadyUsed",
                _ => "plus.err.redeem"
            });
        }
        finally { _busy = false; }
    }

    private void CreateInvite()
    {
        if (_account is null || _account.Role != AccountRole.Admin) return;
        _busy = true;
        try
        {
            var inv = Invites.Create(_account.Id, _inviteDays, _inviteMax);
            _createdCode = inv.Code;
            _invites = Invites.List().ToList();
            _plusOk = true;
            _plusMessage = Loc.T("plus.inviteCreated");
        }
        catch (InvalidOperationException ex)
        {
            _plusOk = false;
            _plusMessage = Loc.T(ex.Message == "InviteLimit" ? "plus.err.limit" : "plus.err.create");
        }
        finally { _busy = false; }
    }

    private void DeleteInvite(string id)
    {
        if (_account?.Role != AccountRole.Admin) return;
        Invites.Delete(id);
        _invites = Invites.List().ToList();
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        if (_account is null) return;
        _busy = true;
        _message = null;
        try
        {
            var file = e.File;
            if (file.Size > AvatarCatalog.MaxUploadBytes)
            {
                _ok = false;
                _message = Loc.T("auth.err.avatarSize");
                return;
            }

            await using var stream = file.OpenReadStream(AvatarCatalog.MaxUploadBytes);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            _account = Store.SaveCustomAvatar(_account.Id, ms, file.ContentType);
            _avatarId = AvatarCatalog.CustomId;
            _hasCustomFile = true;
            _ok = true;
            _message = Loc.T("auth.avatarUploaded");
        }
        catch (InvalidOperationException ex) when (ex.Message is "AvatarType" or "AvatarSize")
        {
            _ok = false;
            _message = Loc.T(ex.Message == "AvatarType" ? "auth.err.avatarType" : "auth.err.avatarSize");
        }
        catch
        {
            _ok = false;
            _message = Loc.T("auth.err.avatarUpload");
        }
        finally
        {
            _busy = false;
        }
    }

    private void Save()
    {
        if (_account is null) return;
        try
        {
            _account = Store.UpdateProfile(_account.Id, _displayName, _avatarId);
            _displayName = _account.DisplayName;
            _avatarId = _account.AvatarId;
            _favCount = Store.FavoriteFactionMatchCount(_account.Id);
            _hasCustomFile = Store.FindAvatarFile(_account.Id) is not null;
            _ok = true;
            _message = Loc.T("auth.saved");
        }
        catch
        {
            _ok = false;
            _message = Loc.T("auth.err.save");
        }
    }
}
