@page "/play"
@page "/play/{Mode}"
@layout GameLayout
@inject WebGwentApiClient Api
@inject LocaleService Loc
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AccountAuthService Auth
@implements IDisposable
@using WebGwent.Game.Models
@using WebGwent.Game.Services
@using WebGwent.Server.Services

<PageTitle>WebGwent — @Loc.T("play.bot")</PageTitle>

@if (_view is null)
{
    <div class="setup-panel wide">
        <h1>@Loc.T("play.bot")</h1>
        <label>@Loc.T("play.yourDeck")
            <select @bind="_deck0Id">
                @foreach (var d in _decks)
                {
                    <option value="@d.Id">@DeckLabel(d)</option>
                }
            </select>
        </label>
        <label>@Loc.T("play.botDeck")
            <select @bind="_deck1Id">
                @foreach (var d in _decks)
                {
                    <option value="@d.Id">@DeckLabel(d)</option>
                }
            </select>
        </label>
        <label>@Loc.T("play.difficulty")
            <select @bind="_difficulty">
                <option value="@BotDifficulty.Easy">@Loc.T("play.diff.easy")</option>
                <option value="@BotDifficulty.Medium">@Loc.T("play.diff.medium")</option>
                <option value="@BotDifficulty.High">@Loc.T("play.diff.high")@(_hasPlus ? "" : $" � {Loc.T("plus.badge")}")</option>
                <option value="@BotDifficulty.DeathMarch">@Loc.T("play.diff.death")@(_hasPlus ? "" : $" � {Loc.T("plus.badge")}")</option>
            </select>
        </label>
        @if (!_hasPlus && BotDifficultyRules.RequiresPlus(_difficulty))
        {
            <p class="muted">@Loc.T("plus.needForDifficulty") <a href="/account/profile">@Loc.T("plus.goProfile")</a></p>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-banner">@_error</div>
        }
        <button class="btn primary" @onclick="Start" disabled="@(!_hasPlus && BotDifficultyRules.RequiresPlus(_difficulty))">@Loc.T("play.start")</button>
        <a class="link-back" href="/home">@Loc.T("play.back")</a>
        <a class="link-back" href="/decks/builder">@Loc.T("decks.openBuilder")</a>
    </div>
}
else
{
    <GameBoard View="_view"
               YouProfile="_youProfile"
               OppProfile="_oppProfile"
               Error="@_error"
               InputLocked="@_botBusy"
               OnMulligan="Mulligan"
               OnFinishMulligan="FinishMulligan"
               OnPlay="PlayCard"
               OnPass="Pass"
               OnUseLeader="UseLeader"
               OnResolvePending="ResolvePending"
               OnChooseStart="ChooseStart"
               OnPlayAgain="PlayAgain" />
}

@code {
    [Parameter] public string? Mode { get; set; }

    private Guid _deck0Id;
    private Guid _deck1Id;
    private BotDifficulty _difficulty = BotDifficulty.Medium;
    private Guid _matchId;
    private MatchView? _view;
    private string? _error;
    private bool _botBusy;
    private bool _matchEndSwept;
    private bool _hasPlus;
    private BoardProfile? _youProfile;
    private BoardProfile? _oppProfile;
    private CancellationTokenSource? _botCts;
    private List<DeckDto> _decks = [];
    private string _youName = "Player";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Mode) && !Mode.Equals("bot", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/play/bot", replace: true);
            return;
        }

        Loc.Changed += OnLang;
        var account = await Auth.GetCurrentAsync();
        _hasPlus = account?.HasPlus == true;
        _youName = account?.DisplayName ?? Loc.T("play.you");
        _decks = (await Api.GetDecksAsync()).ToList();
        if (_decks.Count == 0) return;
        var fav = account?.FavoriteFaction ?? Faction.NorthernRealms;
        _deck0Id = _decks.FirstOrDefault(d => d.Faction == fav)?.Id
                   ?? _decks.FirstOrDefault(d => d.Faction == Faction.NorthernRealms)?.Id
                   ?? _decks[0].Id;
        _deck1Id = _decks.FirstOrDefault(d => d.Faction == Faction.Nilfgaard)?.Id ?? _decks[^1].Id;
    }

    private void OnLang() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Loc.Changed -= OnLang;
        _botCts?.Cancel();
        _botCts?.Dispose();
    }

    private string DeckLabel(DeckDto d) =>
        $"{(d.IsPreset ? "★ " : "")}{d.Name} ({Loc.FactionName(d.Faction)})";

    private Task PlayAgain() => Start();

    private async Task Start()
    {
        _error = null;
        try
        {
            _botCts?.Cancel();
            _botCts?.Dispose();
            _botCts = null;
            _botBusy = false;

            var board = await Api.CreateBotMatchAsync(
                _deck0Id, _deck1Id, _difficulty, _youName, Loc.T("play.botName"));
            ApplyBoard(board);
            _matchEndSwept = false;
            await AnimateBotAsync();
        }
        catch (InvalidOperationException ex) when (ex.Message == "PlusRequired")
        {
            _error = Loc.T("plus.required");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ApplyBoard(MatchBoardDto board)
    {
        _matchId = board.View.MatchId;
        _view = board.View;
        _youProfile = board.You;
        _oppProfile = board.Opponent;
        _error = null;
    }

    private Task Mulligan(Guid id) => ActAsync(() => Api.BotMulliganAsync(_matchId, id));
    private Task FinishMulligan() => ActAsync(() => Api.BotFinishMulliganAsync(_matchId));
    private Task Pass() => ActAsync(() => Api.BotPassAsync(_matchId));
    private Task UseLeader() => ActAsync(() => Api.BotLeaderAsync(_matchId));
    private Task ChooseStart(int who) => ActAsync(() => Api.BotChooseStartAsync(_matchId, who));
    private Task PlayCard((Guid CardId, CombatRow? Row, Guid? Target) args) =>
        ActAsync(() => Api.BotPlayAsync(_matchId, args.CardId, args.Row, args.Target));
    private Task ResolvePending((Guid? Target, CombatRow? Row) args) =>
        ActAsync(() => Api.BotPendingAsync(_matchId, args.Target, args.Row));

    private async Task ActAsync(Func<Task<MatchBoardDto>> action)
    {
        if (_botBusy) return;
        _botBusy = true;
        try
        {
            ApplyBoard(await action());
            await InvokeAsync(StateHasChanged);
            await ResolveBoardClearAsync();
            _botBusy = false;
            await AnimateBotAsync();
        }
        catch (Exception ex)
        {
            _botBusy = false;
            _error = ex.Message switch
            {
                "NoDecoyTargets" => Loc.T("play.err.noDecoy"),
                _ => ex.Message
            };
        }
    }

    private async Task ResolveBoardClearAsync(CancellationToken ct = default)
    {
        if (_view?.Phase == MatchPhase.RoundEnd)
        {
            await InvokeAsync(StateHasChanged);
            await SweepAsync();
            if (ct.IsCancellationRequested) return;
            ApplyBoard(await Api.BotContinueRoundAsync(_matchId));
            await InvokeAsync(StateHasChanged);
        }
        else if (_view?.Phase == MatchPhase.MatchEnd && !_matchEndSwept)
        {
            _matchEndSwept = true;
            await InvokeAsync(StateHasChanged);
            await SweepAsync();
        }
    }

    private async Task SweepAsync()
    {
        try { await Js.InvokeAsync<bool>("webGwent.sweepBoardToDiscard"); }
        catch (JSException) { await Task.Delay(400); }
    }

    private const int BotResponseDelayMs = 1200;

    private bool BotActsNext() =>
        _view is { Phase: MatchPhase.Playing } && !_view.IsYourTurn;

    private async Task AnimateBotAsync()
    {
        _botCts?.Cancel();
        _botCts?.Dispose();
        _botCts = new CancellationTokenSource();
        var ct = _botCts.Token;

        _botBusy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var steps = 0;
            var pauseBeforeBot = true;
            while (steps++ < 40)
            {
                if (ct.IsCancellationRequested) break;

                if (_view?.Phase == MatchPhase.RoundEnd)
                {
                    await ResolveBoardClearAsync(ct);
                    pauseBeforeBot = true;
                    continue;
                }

                if (_view?.Phase == MatchPhase.MatchEnd)
                {
                    await ResolveBoardClearAsync(ct);
                    break;
                }

                if (pauseBeforeBot && BotActsNext())
                    await Task.Delay(BotResponseDelayMs, ct);
                pauseBeforeBot = false;

                var step = await Api.BotStepAsync(_matchId);
                if (!step.Stepped)
                    break;

                ApplyBoard(step.Board);
                await InvokeAsync(StateHasChanged);

                if (_view?.Phase == MatchPhase.RoundEnd || _view?.Phase == MatchPhase.MatchEnd)
                {
                    await ResolveBoardClearAsync(ct);
                    if (_view?.Phase == MatchPhase.MatchEnd) break;
                    continue;
                }

                var delay = _view?.Phase == MatchPhase.Mulligan ? 60
                    : _view?.LastPlayedCardId is not null ? 1100
                    : 850;
                await Task.Delay(delay, ct);
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            try { ApplyBoard(await Api.GetBotMatchAsync(_matchId)); } catch { /* ignore */ }
            _botBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
