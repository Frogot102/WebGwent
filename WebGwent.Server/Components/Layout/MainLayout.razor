@inherits LayoutComponentBase
@inject LocaleService Loc
@inject AccountAuthService Auth
@inject TokenStore Tokens
@inject AuthenticationStateProvider AuthState
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using WebGwent.Server.Accounts
@using WebGwent.Server.Services

<div class="menu-shell @(_showAds ? "with-ads" : "")">
    <header class="menu-header">
        <a class="brand" href="/home">WebGwent</a>
        <nav>
            <a href="/home">@Loc.T("nav.play")</a>
            <a href="/decks">@Loc.T("nav.decks")</a>
            <a href="/rules">@Loc.T("nav.rules")</a>
            <a href="/about">@Loc.T("nav.about")</a>
            @if (_account is not null)
            {
                <a href="/account/profile" class="nav-account">
                    <PlayerAvatar Account="_account" CssClass="nav-avatar" Size="24" />
                    @_account.DisplayName
                    @if (_account.HasPlus)
                    {
                        <span class="plus-pill">Plus</span>
                    }
                    <span class="nav-rating">@_account.Rating</span>
                </a>
                <a href="/account/history">@Loc.T("auth.history")</a>
                <a href="/account/logout">@Loc.T("auth.logout")</a>
            }
            else
            {
                <a href="/account/login">@Loc.T("auth.login")</a>
                <a href="/account/register">@Loc.T("auth.register")</a>
            }
            <LanguageSwitcher />
        </nav>
    </header>
    <div class="menu-body">
        @if (_showAds)
        {
            <aside class="ad-rail ad-rail-left" aria-label="@Loc.T("ads.label")">
                <div class="ad-slot">
                    <span class="ad-kicker">@Loc.T("ads.label")</span>
                    <p>@Loc.T("ads.slotLeft")</p>
                </div>
            </aside>
        }
        <main class="menu-main">
            @Body
        </main>
        @if (_showAds)
        {
            <aside class="ad-rail ad-rail-right" aria-label="@Loc.T("ads.label")">
                <div class="ad-slot">
                    <span class="ad-kicker">@Loc.T("ads.label")</span>
                    <p>@Loc.T("ads.slotRight")</p>
                </div>
            </aside>
        }
    </div>
</div>

@code {
    private PlayerAccount? _account;
    private bool _showAds;

    protected override async Task OnInitializedAsync()
    {
        Loc.Changed += OnChanged;
        AuthState.AuthenticationStateChanged += OnAuthChanged;
        await Tokens.EnsureHydratedAsync();
        await RefreshAccountAsync();
    }

    private async void OnAuthChanged(Task<AuthenticationState> _)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await RefreshAccountAsync();
                StateHasChanged();
            });
        }
        catch
        {
            /* disposed */
        }
    }

    private async Task RefreshAccountAsync()
    {
        _account = await Auth.GetCurrentAsync();
        _showAds = _account?.ShowAds ?? true;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Loc.Changed -= OnChanged;
        AuthState.AuthenticationStateChanged -= OnAuthChanged;
    }
}
